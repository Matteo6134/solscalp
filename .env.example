# ---- RPC ----
# Public RPC works for read-only checks but is rate-limited and flaky.
# Helius free tier recommended: https://helius.dev  (1M credits/month)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_FALLBACK=https://api.mainnet-beta.solana.com

# ---- Free, keyless data sources (no key needed) ----
# Dexscreener  : 60 req/min, batches 30 mints per call, live snapshots only
# GeckoTerminal: 30 req/min, OHLCV up to 6 months
# Jupiter      : quotes + swap tx build
# RugCheck     : read endpoints are keyless

# ---- Optional ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Execution mode ----
# paper | live   -- 'live' additionally requires SOLSCALP_ALLOW_LIVE=I_UNDERSTAND
MODE=paper
SOLSCALP_ALLOW_LIVE=
