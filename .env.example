# Template for .env -- copy it, then fill in your own values:
#     cp .env.example .env
#
# This file is COMMITTED and must never contain a real credential.
# .env is gitignored and is where your actual keys live.
#
# A running process keeps whatever it read at STARTUP. Editing .env does not
# reach it, so after changing anything here: npm run stop && npm run start.

# ---- RPC ----
# The public endpoint is not good enough in practice: it returns 429 on
# getTokenLargestAccounts under any load, so layer 3 errors and -- under
# fail-closed rules -- every token gets rejected. You would be measuring the
# rate limiter instead of the tokens. Helius free tier is enough:
#   https://helius.dev   ->  https://mainnet.helius-rpc.com/?api-key=YOUR-KEY
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URL_FALLBACK=https://api.mainnet-beta.solana.com

# ---- Free, keyless data sources (no key needed) ----
# Dexscreener  : 60 req/min, batches 30 mints per call, live snapshots only
# GeckoTerminal: 30 req/min, OHLCV up to 6 months
# Jupiter      : quotes ONLY -- this repo never builds or signs a transaction
# RugCheck     : read endpoints are keyless

# ---- Telegram (optional) ----
# Both or neither: one alone is a misconfiguration and loadEnv says so. With
# neither, alerts are simply off, which is not an error.
# Token from @BotFather, chat id from @userinfobot. You must message the bot
# first -- a bot cannot open a conversation, so before that it can only answer
# 'chat not found'.
# Use a bot of its own: Telegram allows exactly ONE getUpdates consumer per
# token, so sharing a token with another running bot breaks both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Execution mode ----
# 'paper' is the only value that works.
#
# MODE=live THROWS -- with or without the acknowledgement below. It is a
# tripwire, not a switch: there is no keypair in this repo and no code that can
# sign a transaction, so no environment variable can turn on live trading. If it
# could, the safety of the whole thing would rest on a config file rather than on
# the absence of the capability.
MODE=paper
SOLSCALP_ALLOW_LIVE=
